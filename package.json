{
  "name": "argus-shogun-engine",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "smoke:backend": "tsx scripts/backend-smoke.mjs",
    "smoke:nutrition": "tsx scripts/nutrition-smoke.ts",
    "smoke:nutrition-integrity": "tsx scripts/nutrition-integrity-smoke.ts",
    "smoke:work-audit": "tsx scripts/work-audit-smoke.ts && tsx scripts/release-architecture-smoke.ts",
    "smoke:release": "tsx scripts/release-architecture-smoke.ts",
    "test": "npm run smoke:backend && npm run smoke:nutrition && npm run smoke:nutrition-integrity && npm run smoke:work-audit",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
